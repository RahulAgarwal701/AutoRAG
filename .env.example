# Application
APP_NAME=AutoRAG API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
PORT=8000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
WIDGET_SESSION_TOKEN_EXPIRE_MINUTES=30
API_KEY_RATE_LIMIT=60
IP_RATE_LIMIT=120
WIDGET_SESSION_IP_RATE_LIMIT=30
RATE_LIMIT_WINDOW_SECONDS=60

# PostgreSQL
POSTGRES_USER=autorag
POSTGRES_PASSWORD=autorag
POSTGRES_DB=autorag
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://autorag:autorag@localhost:5433/autorag
GEMINI_API_KEY=api key here
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1536
SPARSE_EMBEDDING_PROVIDER=bm25

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Temporal
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=autorag-ingestion
RUN_TEMPORAL_WORKER_IN_PROCESS=false

# Local S3-compatible storage (MinIO)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=autorag-documents
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
MAX_UPLOAD_SIZE_MB=25
S3_PRESIGNED_URL_EXPIRY_SECONDS=900

# Gemini embeddings (free-tier key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
SPARSE_EMBEDDING_PROVIDER=bm25
QUERY_REWRITE_MODEL=gemini-3.5-flash-lite

# Optional reranking (required only for agents with use_reranker=true)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
RETRIEVAL_RELEVANCE_THRESHOLD=0.2

# Answer generation (configure the provider selected on each agent)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Optional agent tools. Webhooks must be HTTPS and explicitly allowlisted.
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=
TOOL_WEBHOOK_ALLOWED_HOSTS=

# Vector storage
QDRANT_COLLECTION_NAME=autorag_chunks

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Observability (optional locally)
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

